---
import Page from '../../../layouts/Page.astro';
import GuideDoorway from '../../../framing/GuideDoorway.astro';
import PathBadge from '../../../framing/PathBadge.astro';
import SafetyNote from '../../../framing/SafetyNote.astro';
import PracticeRoute from '../../../framing/PracticeRoute.astro';
import {
	BELIEF_LINE,
	PENDING_MARKER,
	REFUSAL,
	SMALLEST_LEAD,
} from '../../../framing/practice-view.js';
import { loadPracticeRoutes, pendingIn, release } from '../../../catalog/index.js';
import { framingFor } from '../../../framing/audience.js';
import { AUDIENCE_PATHS } from '../../../framing/routes.js';

/**
 * The practice view, on every audience path: `/<path>/practice/<slug>/`.
 *
 * One page per practice this release publishes, per path, so **every practice
 * is reachable on every path** (`docs/spec/01-journey-and-ia.md`) and a
 * chaplain can link one directly. The whole record is here, in the fixed shape
 * — what this involves, ways to change it, stop guidance, then the action —
 * and **nothing starts on its own**.
 *
 * What the path changes is the framing: the badge, and the action. What it
 * does not change is **the record**. The canonical steps are identical on all
 * three paths, and so is everything that says what the practice asks of the
 * person doing it — the origin line, the belief line, the smallest version.
 * Those sentences are addressed to whoever is doing the practice, on a
 * companion path as much as anywhere else; a companion reads them about the
 * person they are with rather than about themselves. The notes written for a
 * companion — `companion note`, `companion cautions`, `child keep`, `child
 * change` — belong to "Before you offer this"
 * ([#29](https://github.com/inarush0/spiritual-collective/issues/29)), which is
 * where a companion meets them before anything is offered.
 *
 * Withdrawn records keep this route but render only the unavailable page.
 */
export async function getStaticPaths() {
	const practices = await loadPracticeRoutes();
	return AUDIENCE_PATHS.flatMap((path) =>
		practices.map((practice) => ({
			params: { path, slug: practice.id },
			props: { path, practice },
		})),
	);
}

const { path, practice } = Astro.props;
const record = practice.data;
const framing = framingFor(path);
const action = framing.actionRoute(practice.id);
---

<PracticeRoute path={path} publication={record.publication}>
	<Page title={record.name}>
	{
		/*
		 * The badge names the path, and "Change who this is for" sits with it:
		 * this is the screen where being on the wrong one matters most, because
		 * it is the screen someone acts from.
		 */
	}
	<PathBadge path={path} change />

	<h1>{record.name}</h1>
	<p class="invitation">{record.invitation}</p>
	{pendingIn(release, record.publication) && <p class="pending">{PENDING_MARKER}</p>}

	{
		/*
		 * Provenance in plain language, never the seed material's author and
		 * never a tradition endorsing this version; then what the practice asks
		 * a reader to believe, before they are inside it rather than after.
		 */
	}
	<p class="origin">{record.provenance.origin_line}</p>
	<p class="belief">{BELIEF_LINE[record.belief_requirement]}</p>

	<section>
		<h2>What this involves</h2>
		{/* The canonical sequence, as written. The same steps serve every path. */}
		<ol>
			{record.what_this_involves.map((step) => <li>{step}</li>)}
		</ol>
	</section>

	<section>
		<h2>Ways to change it</h2>
		<p>{record.ways_to_change_it}</p>
		<p class="smallest">{SMALLEST_LEAD} {record.smallest_version}</p>
	</section>

	<section>
		<h2>If you want to stop</h2>
		<p>{record.stop_guidance}</p>
		<SafetyNote />
	</section>

	<div class="choices">
		{
			/*
			 * The action is the way into the stepped view, and the only one:
			 * step one is reached by clicking this and by nothing else. It is
			 * deliberately last and deliberately quiet — the record above is
			 * readable in full first, and nothing here advances by itself.
			 *
			 * On companion paths it enters "Before you offer this" so adaptation
			 * guidance and cautions are met before the first canonical step.
			 */
		}
		<p class="action"><a href={action}>{framing.action}</a></p>
		{/* Refusal is visible, alongside the action rather than beneath it. */}
		<p class="refusal"><a href={framing.routes.everything}>{REFUSAL}</a></p>
	</div>

	<GuideDoorway path={path} />
	</Page>
</PracticeRoute>

<style>
	.invitation {
		margin: 0 0 0.75rem;
		font-size: 1.125rem;
	}

	.origin,
	.belief,
	.smallest {
		color: var(--quiet);
	}

	.origin {
		margin: 0 0 0.25rem;
	}

	.belief {
		margin: 0 0 2rem;
	}

	.pending {
		margin: 0 0 0.75rem;
		color: var(--quiet);
		font-size: 0.875rem;
	}

	section {
		margin: 0 0 2rem;
	}

	h2 {
		font-size: 1.125rem;
		margin: 0 0 0.5rem;
	}

	section p {
		margin: 0 0 0.5rem;
	}

	ol {
		margin: 0;
		padding-left: 1.25rem;
	}

	li + li {
		margin-top: 0.5rem;
	}

	/*
	 * The two sit side by side above 26rem and stack below it, at the same
	 * size either way: a refusal set in smaller type than the action is not a
	 * visible refusal. No media query is needed for the 320px case.
	 */
	.choices {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 2.5rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}

	.choices p {
		margin: 0;
	}
</style>
