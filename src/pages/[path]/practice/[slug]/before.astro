---
import type { Practice } from '../../../../catalog/index.js';
import { loadPracticeRoutes, pendingIn, release } from '../../../../catalog/index.js';
import GuideDoorway from '../../../../framing/GuideDoorway.astro';
import FlowChoices from '../../../../framing/FlowChoices.astro';
import PathBadge from '../../../../framing/PathBadge.astro';
import { PENDING_MARKER } from '../../../../framing/practice-view.js';
import { COMPANION_PATHS, routesFor, type CompanionPath } from '../../../../framing/routes.js';
import {
	BEFORE_TITLE,
	BEING_ALONGSIDE,
	COMPANION_PROGRESS,
	CONTINUE_ALONE,
	LEAVE_HERE,
} from '../../../../framing/stepped-view.js';
import Page from '../../../../layouts/Page.astro';
import UnavailablePractice from '../../../../framing/UnavailablePractice.astro';

interface Props {
	path: CompanionPath;
	practice: Practice;
}

export async function getStaticPaths() {
	const practices = await loadPracticeRoutes();
	return COMPANION_PATHS.flatMap((path) =>
		practices.map((practice) => ({
			params: { path, slug: practice.id },
			props: { path, practice },
		})),
	);
}

const { path, practice } = Astro.props;
const record = practice.data;
const routes = routesFor(path);
const practiceRoute = routes.practice(practice.id);
const directPracticeRoute = routesFor('me').practice(practice.id);
---


{
	record.publication === 'withdrawn' ? (
		<UnavailablePractice path={path} />
	) : (
		<Page title={`${record.name} — ${BEFORE_TITLE}`}>
	<PathBadge path={path} />
	<p class="from"><a href={practiceRoute}>{record.name}</a></p>
	<h1>{BEFORE_TITLE}</h1>
	{pendingIn(release, record.publication) && <p class="pending">{PENDING_MARKER}</p>}

	<section id="being-alongside">
		<h2>{BEING_ALONGSIDE}</h2>
		<p>{record.companion_note}</p>
		<h3>Companion cautions</h3>
		<p>{record.companion_cautions}</p>
	</section>

	{
		path === 'child' && (
			<section>
				<h2>Change this</h2>
				<h3>Keep</h3>
				<p>{record.child_keep}</p>
				<h3>Change</h3>
				<p>{record.child_change}</p>
			</section>
		)
	}

	<section>
		<h2>One step at a time</h2>
		{COMPANION_PROGRESS.map((line) => <p>{line}</p>)}
	</section>

	<FlowChoices>
		<p><a href={`${practiceRoute}1/`}>Offer the first step.</a></p>
		<p><a href={routes.exit}>{LEAVE_HERE}</a></p>
		{
			path === 'with' && (
				<p class="handoff"><a href={`${directPracticeRoute}1/`}>{CONTINUE_ALONE}</a></p>
			)
		}
	</FlowChoices>

			<GuideDoorway path={path} />
		</Page>
	)
}

<style>
	.from,
	.pending {
		margin: 0;
		color: var(--quiet);
		font-size: 0.875rem;
	}

	h1 {
		margin-top: 0.25rem;
	}

	section {
		margin: 2rem 0 0;
	}

	h2 {
		font-size: 1.125rem;
		margin: 0 0 0.5rem;
	}

	h3 {
		font-size: 1rem;
		margin: 1rem 0 0.25rem;
	}

	section p {
		margin: 0 0 0.5rem;
	}

</style>
