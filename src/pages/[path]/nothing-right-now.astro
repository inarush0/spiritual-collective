---
import Page from '../../layouts/Page.astro';
import GuideDoorway from '../../framing/GuideDoorway.astro';
import { NOTHING_LINES, NOTHING_TITLE, nothingOnward } from '../../framing/exits.js';
import { AUDIENCE_PATHS } from '../../framing/routes.js';

/**
 * The kind screen, on every path: `/<path>/nothing-right-now/`.
 *
 * "Nothing right now" is offered as an escape from every set screen and from
 * the exit, so it is a place a person actually arrives at, and it has to hold
 * them: neutral, kind, and making no attempt to win them back
 * (`docs/spec/01-journey-and-ia.md`).
 *
 * **The words do not turn with the path.** They are about the reader's own
 * decision to stop, not about the practice or the person it would have been
 * offered to, and they are as true for a companion who is not going to offer
 * anything today as for a direct user closing the tab. One page per path
 * because the way back from it leads into the flow the reader was in.
 *
 * It is also not a dead end. The one way onward is last, quiet, and phrased as
 * a way back rather than an invitation to reconsider.
 *
 * Every sentence lives in `src/framing/exits.ts`; this template holds none.
 */
export function getStaticPaths() {
	return AUDIENCE_PATHS.map((path) => ({ params: { path }, props: { path } }));
}

const { path } = Astro.props;
const onward = nothingOnward(path);
---

<Page title={NOTHING_TITLE}>
	<h1>{NOTHING_TITLE}</h1>
	{NOTHING_LINES.map((line) => <p>{line}</p>)}

	<p class="onward">
		{onward.before}
		<a href={onward.route}>{onward.words}</a>
		{onward.after}
	</p>

	{
		/*
		 * No badge here, and none on the exit: naming the path is the resource
		 * talking about itself at the moment a reader has said they want
		 * nothing from it. The doorway to the guide stays, because it is the
		 * one thing a companion might still want from this screen.
		 */
	}
	<GuideDoorway path={path} />
</Page>

<style>
	p {
		margin: 0 0 1.25rem;
	}

	.onward {
		margin: 2.5rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		color: var(--quiet);
	}
</style>
