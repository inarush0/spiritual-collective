---
import CompanionDoor from '../../framing/CompanionDoor.astro';

/**
 * `/with/`: the screen someone using this alongside another person lands on.
 *
 * Arrival's second answer leads straight here — a suggestion set, immediately,
 * with no question put to the reader (`docs/spec/01-journey-and-ia.md`). This
 * path's door is the set itself, which is why there is no `/with/` question
 * page for it to sit behind.
 *
 * The screen is `src/framing/CompanionDoor.astro`, shared with `/child/set/`,
 * so that the two doors cannot come to hold different sets.
 */
---

<CompanionDoor path="with" />
