---
import Page from '../../../../layouts/Page.astro';
import Escapes from '../../../../framing/Escapes.astro';
import PracticeSet from '../../../../framing/PracticeSet.astro';
import SetHeading from '../../../../framing/SetHeading.astro';
import { loadCatalog } from '../../../../catalog/index.js';
import { lowEnergySet } from '../../../../catalog/low-energy.js';
import { needTagRoute, offeredNeedTags } from '../../../../catalog/need-tags.js';
import {
	LOW_ENERGY_BACK,
	LOW_ENERGY_EMPTY,
	LOW_ENERGY_LEAD,
	LOW_ENERGY_OUTSIDE_LEAD,
	LOW_ENERGY_TAB,
} from '../../../../framing/discovery.js';

/**
 * The **low-energy variant**, direct-user path: `/me/for/<need-tag-slug>/low/`.
 *
 * The reachable-from-anywhere alternative for someone with almost nothing to
 * give — the practices carrying that tag whose `low energy` is true, and where
 * the tag has none, the ones from outside it that do
 * (`docs/spec/01-journey-and-ia.md`). Membership is `src/catalog/low-energy.ts`;
 * this page decides only how the cases read.
 *
 * **Its own prerendered path, not a toggle or a query string.** Every state of
 * the journey is a real page ([ADR 0001](../../../../../docs/adr/0001-static-zero-js-no-third-party.md)),
 * and there is no client JavaScript to toggle anything with. A reader can also
 * be sent straight here by a chaplain, and reach the same page either way.
 *
 * **One page for every tag the question offers**, built from the same
 * `offeredNeedTags` as the set itself, so the unconditional link in
 * `src/framing/LowEnergyLink.astro` is never a dead one.
 *
 * **No set tail here**, which is this page's one departure from the shape §1
 * gives every set screen, recorded there as well. The tail keeps a screen the
 * same shape by
 * filling it out from the editorial order, but the order knows nothing about
 * energy: a tail under this page would put practices that need getting up on
 * the one page promising the opposite. The fallback is this page's version of
 * that mechanism — same job, same framing, drawn from what can honestly be
 * here. Nor does this page carry the link back to itself.
 *
 * Like the set screen, it carries neither the limits line nor the crisis
 * pointer (`docs/spec/03-safety-and-inclusion.md`): someone arriving here has
 * less to spend than most, and a disclaimer is the last thing that should meet
 * them.
 */
export async function getStaticPaths() {
	const practices = await loadCatalog();
	return offeredNeedTags(practices).map((offer) => ({
		params: { tag: offer.slug },
		props: { tag: offer.tag, ...lowEnergySet(practices, offer.tag) },
	}));
}

const { tag, practices, fromOutsideTheTag } = Astro.props;

/**
 * Emptiness is read before the fallback flag, and it silences the lead as well
 * as the list. A catalog holding no low-energy practice anywhere has fallen
 * back to nothing, and every line the page would otherwise say is about a list
 * that is not there: "everything here works lying down" is a promise made over
 * nothing, and "these are not from what you chose" would be the strangest
 * sentence on the site. One line, and the escapes.
 */
const empty = practices.length === 0;
---

<Page title={LOW_ENERGY_TAB(tag)}>
	{
		/*
		 * The same heading as the set this varies, from the same component: the
		 * reader has answered one question, not two, and nothing here suggests
		 * otherwise.
		 */
	}
	<SetHeading tag={tag} />

	<div class="leads">
		{empty && <p>{LOW_ENERGY_EMPTY}</p>}
		{!empty && LOW_ENERGY_LEAD.map((line) => <p>{line}</p>)}
		{
			/*
			 * Where the tag had none of its own, the label goes between the
			 * promise and the list — the reader meets "these are not from what
			 * you chose" before the practices it is about, not after.
			 */
			fromOutsideTheTag && !empty && LOW_ENERGY_OUTSIDE_LEAD.map((line) => <p>{line}</p>)
		}
	</div>

	{!empty && <PracticeSet practices={practices} />}

	<p class="back">
		<a href={needTagRoute(tag)}>{LOW_ENERGY_BACK}</a>
	</p>

	<Escapes />
</Page>

<style>
	/*
	 * The lead-in paragraphs sit in one block so the space before the list is
	 * the same whether or not the fallback added a line to them. The block's
	 * own margin holds it, rather than a rule about which paragraph happens to
	 * be last.
	 */
	.leads {
		margin-bottom: 2rem;
	}

	.leads p {
		margin: 0 0 0.5rem;
		color: var(--quiet);
	}

	.back {
		margin: 2.5rem 0 0;
	}
</style>
