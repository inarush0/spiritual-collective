---
import { release } from '../catalog/index.js';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{/* No web fonts, no CDN, no analytics, no client JavaScript. ADR 0001. */}
	</head>
	<body>
		{
			release === 'beta' && (
				<p class="beta-bar" role="note">
					beta — for review
				</p>
			)
		}
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	/*
	 * System font stack only — no web fonts, per the weight budget in
	 * docs/spec/07-technical-constraints.md. Sized in rem so 200% zoom and a
	 * 320px viewport both work without a media query (docs/spec/04).
	 */
	:root {
		--ink: #1a1a1a;
		--quiet: #4a4a4a;
		--rule: #d8d4cc;
		--page: #fbfaf8;
	}

	html {
		box-sizing: border-box;
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			Roboto,
			'Helvetica Neue',
			Arial,
			sans-serif;
		color: var(--ink);
		background: var(--page);
		line-height: 1.6;
	}

	*,
	*::before,
	*::after {
		box-sizing: inherit;
	}

	body {
		margin: 0;
		padding: 1.5rem 1.25rem 4rem;
	}

	main {
		max-width: 38rem;
		margin: 0 auto;
	}

	h1 {
		font-size: 1.5rem;
		line-height: 1.3;
		margin: 0 0 0.5rem;
	}

	.beta-bar {
		max-width: 38rem;
		margin: 0 auto 1.5rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--rule);
		border-radius: 0.25rem;
		color: var(--quiet);
		font-size: 0.875rem;
	}
</style>
