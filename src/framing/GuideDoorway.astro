---
import { GUIDE_DOORWAY } from './companion.js';
import { GUIDE_ROUTE, isCompanionPath, isHere, type AudiencePath } from './routes.js';
import { loadGuide } from '../guide/index.js';

interface Props {
	path: AudiencePath;
}

const { path } = Astro.props;

/**
 * The quiet doorway back to the **standing guide**, on every companion screen.
 *
 * How to offer a practice and how to adapt one are written once, on `/child/`,
 * and a companion who arrived through `/with/` has never seen that page. So it
 * stays reachable from every screen they meet (`docs/spec/01-journey-and-ia.md`)
 * rather than only from the screen they landed on.
 *
 * **The condition is in this file rather than in the pages.** "Never shown to
 * the direct user" is a rule about the guide, not a fact about which template
 * happens to render it: the guide addresses a companion about another person,
 * and a direct user meeting it would be handed a page about being cared for.
 * A page asks for the doorway and gets one only if it is on a path that has
 * one.
 *
 * **It is a sentence when the guide record is not published**, rather than a
 * link — a dead link is the one thing a doorway must not be. The words are
 * still worth having there: they say where how-to-offer and how-to-adapt would
 * be, which is a truer page than one that quietly loses the line.
 *
 * On the guide itself the doorway is nothing at all: a companion reading the
 * guide is not offered a way to the guide.
 */
const guide = await loadGuide();
const showGuide = isCompanionPath(path) && !isHere(Astro.url.pathname, GUIDE_ROUTE);
---

{
	showGuide && (
		<p class="doorway">
			{guide ? <a href={GUIDE_ROUTE}>{GUIDE_DOORWAY}</a> : GUIDE_DOORWAY}
		</p>
	)
}

<style>
	/*
	 * Quiet, and below the ways further in: it is the page a companion can go
	 * back to rather than another thing to choose from here.
	 */
	.doorway {
		margin: 1.5rem 0 0;
		color: var(--quiet);
	}
</style>
