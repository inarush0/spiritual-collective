---
import type { Practice } from '../catalog/index.js';
import { pendingIn, release } from '../catalog/index.js';
import Page from '../layouts/Page.astro';
import GuideDoorway from './GuideDoorway.astro';
import PathBadge from './PathBadge.astro';
import { PENDING_MARKER, SMALLEST_LEAD } from './practice-view.js';
import { isCompanionPath, routesFor, type AudiencePath } from './routes.js';
import {
	BEING_ALONGSIDE,
	CHANGE_THIS,
	COMPANION_PROGRESS,
	CONTINUE_ALONE,
	LAST_STEP,
	LEAVE_HERE,
	NEXT,
	ONWARD,
	PERSON_STEP_LEAD,
	STOP,
	stepLabel,
} from './stepped-view.js';

interface Props {
	path: AudiencePath;
	practice: Practice;
	step: string;
	number: number;
}

/**
 * One rendering of a canonical step for all three audience paths.
 *
 * The `step` prop comes straight from `what_this_involves` and is rendered in
 * exactly one place. Companion paths add a wrapper around it; no branch can
 * rewrite, add to, or reorder the canonical instruction.
 */
const { path, practice, step, number } = Astro.props;
const record = practice.data;
const companion = isCompanionPath(path);
const routes = routesFor(path);
const practiceRoute = routes.practice(practice.id);
const total = record.what_this_involves.length;
const label = stepLabel(number, total);
const isLast = number === total;
const beforeRoute = `${practiceRoute}before/`;
---

<Page title={`${record.name} — ${label}`}>
	<PathBadge path={path} />

	<p class="from"><a href={practiceRoute}>{record.name}</a></p>
	<p class="where">{label}</p>
	{pendingIn(release, record.publication) && <p class="pending">{PENDING_MARKER}</p>}

	{companion && <p class="address">{PERSON_STEP_LEAD}</p>}
	<h1 class="step">{step}</h1>

	{
		companion && (
			<aside class="companion">
				<p>{COMPANION_PROGRESS[0]}</p>
				<p><a href={`${beforeRoute}#being-alongside`}>{BEING_ALONGSIDE}</a></p>
			</aside>
		)
	}

	<details class="change">
		<summary>{CHANGE_THIS}</summary>
		<p>{record.ways_to_change_it}</p>
		<p class="smallest">{SMALLEST_LEAD} {record.smallest_version}</p>
		{
			path === 'child' && (
				<div class="child-change">
					<p><strong>Keep:</strong> {record.child_keep}</p>
					<p><strong>Change:</strong> {record.child_change}</p>
				</div>
			)
		}
	</details>

	<div class="choices">
		{
			isLast ? (
				<p class="onward">
					<span class="last">{LAST_STEP}</span>
					<a href={routes.exit}>{ONWARD}</a>
				</p>
			) : (
				<p class="onward"><a href={`${practiceRoute}${number + 1}/`}>{NEXT}</a></p>
			)
		}
		<p class="stop"><a href={routes.exit}>{companion ? LEAVE_HERE : STOP}</a></p>
		{
			path === 'with' && (
				<p class="handoff">
					<a href={`/me/practice/${practice.id}/${number}/`}>{CONTINUE_ALONE}</a>
				</p>
			)
		}
	</div>

	<GuideDoorway path={path} />
</Page>

<style>
	.from,
	.where,
	.pending,
	.address {
		margin: 0;
		color: var(--quiet);
		font-size: 0.875rem;
	}

	.address {
		margin-top: 1.5rem;
	}

	.step {
		font-size: 1.375rem;
		line-height: 1.4;
		margin: 1.5rem 0 2.5rem;
	}

	.address + .step {
		margin-top: 0.25rem;
	}

	.companion {
		margin: 0 0 1.5rem;
		padding: 1rem;
		border-left: 0.2rem solid var(--rule);
		color: var(--quiet);
	}

	.companion p,
	.child-change p {
		margin: 0;
	}

	.companion p + p,
	.child-change p + p {
		margin-top: 0.5rem;
	}

	.change {
		border-top: 1px solid var(--rule);
		padding-top: 1rem;
	}

	.change summary {
		cursor: pointer;
	}

	.change > p,
	.child-change {
		margin: 0.75rem 0 0;
	}

	.smallest,
	.child-change {
		color: var(--quiet);
	}

	.choices {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 2.5rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}

	.choices p {
		margin: 0;
	}

	.last {
		display: block;
		color: var(--quiet);
	}

	.handoff {
		flex-basis: 100%;
	}
</style>
