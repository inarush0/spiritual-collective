---
import type { Practice } from '../catalog/index.js';
import { loadCatalog } from '../catalog/index.js';
import { setTail } from '../catalog/set-tail.js';
import PracticeSet from './PracticeSet.astro';
import { TAIL_LEAD, TAIL_TITLE } from './discovery.js';
import type { AudiencePath } from './routes.js';

interface Props {
	/** What is already on screen above the divider, in the editorial order. */
	set: Practice[];
	/** The path the set screen is on; its entries link there too. */
	path: AudiencePath;
}

const { set, path } = Astro.props;

/**
 * The **set tail**, below every suggestion set
 * ([#25](https://github.com/inarush0/spiritual-collective/issues/25)).
 *
 * One component, and it reads the catalog itself, so that a set screen carries
 * the tail by naming the set it is showing and nothing else. "Below every set"
 * is then a line a page opts into rather than a block each template spells
 * again — and a page cannot accidentally carry a tail drawn from a smaller
 * catalog than the one above the line.
 *
 * The rules it holds (`docs/spec/01-journey-and-ia.md`):
 *
 * - **A quiet divider**, then the tail. Quiet because the tail is not a second
 *   offer competing with the set; a divider because the reader has to be able
 *   to see where the answer they chose stopped.
 * - **Labelled as not matching what was chosen.** Said in words, above the
 *   list, in `./discovery.ts`.
 * - **The same entries, at the same size.** It renders through the same
 *   `PracticeSet` as the set above it, so nothing below the line is a smaller
 *   or quieter kind of practice. Only the heading level differs, for the
 *   outline.
 *
 * Nothing is drawn when the tail is empty, which happens only when the whole
 * catalog is already above the divider. That is not the layout varying with
 * how well-stocked an answer was: a screen showing everything there is cannot
 * leak anything by showing nothing more, and a divider under a label saying
 * "these are not what you chose" over an empty list would be the stranger
 * page. `/me/everything/` is that case by definition, so it does not carry a
 * tail at all, on any path, and §1 carries the carve-out
 * ([#49](https://github.com/inarush0/spiritual-collective/issues/49)).
 *
 * The tail's own wording does not change with the path. It says these are not
 * what the reader chose and where they came from instead, and both facts are
 * about the list rather than about whoever is reading it.
 */
const tail = setTail(await loadCatalog(), set);
---

{
	tail.length > 0 && (
		<section class="tail" aria-labelledby="tail-title">
			<h2 id="tail-title">{TAIL_TITLE}</h2>
			{TAIL_LEAD.map((line) => (
				<p class="lead">{line}</p>
			))}
			<PracticeSet practices={tail} path={path} level={3} />
		</section>
	)
}

<style>
	/*
	 * The quiet divider, drawn as the section's own top border rather than an
	 * `<hr>`: it is a change of footing on one page, not a break between two
	 * documents.
	 */
	.tail {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}

	/*
	 * The title sits below the entries in size on purpose. Above the divider
	 * the set's lead-in is quiet body text too: the tail is shaped like the
	 * set, and a louder heading here would make the space below the line read
	 * as a second, better-stocked offer. The entries themselves are the same
	 * size as the set's, which is the size rule that matters.
	 */
	.tail h2 {
		font-size: 1rem;
		margin: 0 0 0.25rem;
	}

	.lead {
		margin: 0 0 0.5rem;
		color: var(--quiet);
	}

	.lead:last-of-type {
		margin-bottom: 2rem;
	}
</style>
