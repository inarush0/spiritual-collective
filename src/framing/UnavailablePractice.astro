---
import Page from '../layouts/Page.astro';
import Escapes from './Escapes.astro';
import GuideDoorway from './GuideDoorway.astro';
import PathBadge from './PathBadge.astro';
import { PRACTICE_UNAVAILABLE } from './practice-view.js';
import type { AudiencePath } from './routes.js';

interface Props {
	path: AudiencePath;
}

const { path } = Astro.props;
---

<Page title={PRACTICE_UNAVAILABLE}>
	<PathBadge path={path} change />
	<h1>{PRACTICE_UNAVAILABLE}</h1>
	<Escapes path={path} />
	<GuideDoorway path={path} />
</Page>
