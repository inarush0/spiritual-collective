---
import type { NeedTag } from '../catalog/practice-record.js';
import { framingFor } from './audience.js';
import type { AudiencePath } from './routes.js';

interface Props {
	/** The answer whose set this is. The variant lives under its route. */
	tag: NeedTag;
	/** The path the set screen is on. */
	path: AudiencePath;
}

const { tag, path } = Astro.props;
const { routes, lowEnergyLink } = framingFor(path);

/**
 * The link to the **low-energy variant**, below the **set tail** on every set
 * screen ([#26](https://github.com/inarush0/spiritual-collective/issues/26)).
 *
 * There is **no condition in this file**, and that is the whole reason it is a
 * file. The link is offered whether or not the chosen tag has any low-energy
 * practice behind it (`docs/spec/01-journey-and-ia.md`): a link rendered only
 * where the variant was stocked would tell the reader that their answer came
 * up short, which is precisely the verdict none of these screens may deliver.
 * A component with nothing to branch on cannot acquire that condition later by
 * someone adding a helpful `&&` to one page.
 *
 * It sits below the tail rather than beside the set, because it is an
 * adjustment to what is on screen rather than another thing on it, and above
 * the escapes, because it is still a way further in rather than a way out.
 *
 * The **wording turns with the path** while the need tags do not. A need tag
 * is a first-person string a reader is offered verbatim; this is the page
 * talking to whoever is holding the screen, and on a companion path that is
 * not the person who would be lying down.
 */
---

<p class="low-energy">
	<a href={routes.lowEnergy(tag)}>{lowEnergyLink}</a>
</p>

<style>
	/*
	 * At the size of the page's own text: this is one of the adjustments a set
	 * screen offers, not a quiet aside for readers who need special handling.
	 */
	.low-energy {
		margin: 2.5rem 0 0;
	}
</style>
